#!/bin/sh

WIFI_KEY='password'

# 第一个无线接口：通常为 2.4 GHz
uci -q set wireless.@wifi-device[0].disabled='0'
uci -q set wireless.@wifi-iface[0].disabled='0'
uci -q set wireless.@wifi-iface[0].network='lan'
uci -q set wireless.@wifi-iface[0].mode='ap'
uci -q set wireless.@wifi-iface[0].ssid='Ponwrt-2.4G'
uci -q set wireless.@wifi-iface[0].encryption='sae-mixed'
uci -q set wireless.@wifi-iface[0].key="$WIFI_KEY"

# 第二个无线接口：通常为 5 GHz
uci -q set wireless.@wifi-device[1].disabled='0'
uci -q set wireless.@wifi-iface[1].disabled='0'
uci -q set wireless.@wifi-iface[1].network='lan'
uci -q set wireless.@wifi-iface[1].mode='ap'
uci -q set wireless.@wifi-iface[1].ssid='Ponwrt-5G'
uci -q set wireless.@wifi-iface[1].encryption='sae-mixed'
uci -q set wireless.@wifi-iface[1].key="$WIFI_KEY"

uci commit wireless
exit 0
